{
  "name": "userscripts",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*"
    ]
  },
  "scripts": {
    "build": "bun run build:cli",
    "build:cli": "bun run --cwd ./packages/usts build",
    "format": "biome check --write",
    "lint": "biome check",
    "test": "bun run test:cli",
    "test:cli": "bun run --cwd ./packages/usts test"
  },
  "overrides": {
    "rolldown": "1.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@gameroman/config": "0.3.0"
  }
}
