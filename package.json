{
  "name": "userscripts",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalogs": {
      "registry": {
        "@astrojs/solid-js": "7.0.1",
        "@tailwindcss/vite": "4.3.2",
        "astro": "7.0.7",
        "solid-js": "1.9.14",
        "tailwindcss": "4.3.2"
      }
    }
  },
  "scripts": {
    "build": "bun run build:cli",
    "build:app": "bun run --cwd ./apps/registry build",
    "build:cli": "bun run --cwd ./packages/usts build",
    "format": "biome check --write --linter-enabled=false",
    "lint": "biome check",
    "test": "bun run test:cli",
    "test:cli": "bun run --cwd ./packages/usts test"
  },
  "overrides": {
    "@cloudflare/vite-plugin": "1.45.1",
    "esbuild": "0.28.1",
    "get-tsconfig": "5.0.0-beta.5",
    "semver": "7.8.5",
    "unstorage": "2.0.0-alpha.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@gameroman/config": "0.2.5"
  }
}
