{
  "name": "userscripts",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ]
  },
  "scripts": {
    "build": "bun run build:cli",
    "build:app": "bun run --cwd ./apps/registry build",
    "build:cli": "bun run --cwd ./packages/usts build",
    "format": "biome check --write",
    "lint": "biome check",
    "test": "bun run test:cli",
    "test:cli": "bun run --cwd ./packages/usts test"
  },
  "overrides": {
    "@babel/helper-module-imports": "7.29.7",
    "@cloudflare/vite-plugin": "1.54.1",
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3",
    "@emnapi/wasi-threads": "2.0.1",
    "esbuild": "0.28.2",
    "get-tsconfig": "5.0.0-beta.6",
    "js-yaml": "npm:neoyaml@0.1.2",
    "rolldown": "1.2.6",
    "semver": "7.8.5",
    "unstorage": "2.0.0-alpha.9"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@gameroman/config": "0.2.9"
  }
}
